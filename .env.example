# ---- Server configuration ----

# Port the server listens on (Render/Railway/Fly set this automatically)
PORT=4000

# Where the SQLite database file lives. On a cloud host with a persistent
# disk/volume, point this at the mounted path (e.g. /data/family.sqlite).
DATABASE_PATH=./data/family.sqlite

# Secret used to sign login tokens. MUST be a long random string in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Optional: if set, new users must enter this code to create an account.
# Leave blank to allow open signup (fine while you're the only one who has the link).
INVITE_CODE=

# How often (in minutes) to refresh subscribed Google Calendar feeds.
FEED_REFRESH_MINUTES=30

# ---- Server configuration ----

# Port the server listens on (Render/Railway/Fly set this automatically)
PORT=4000

# Where the SQLite database file lives. On a cloud host with a persistent
# disk/volume, point this at the mounted path (e.g. /data/family.sqlite).
DATABASE_PATH=./data/family.sqlite

# Secret used to sign login tokens. MUST be a long random string in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Optional: if set, new users must enter this code to create an account.
# Leave blank to allow open signup (fine while you're the only one who has the link).
INVITE_CODE=

# How often (in minutes) to refresh subscribed Google Calendar feeds.
FEED_REFRESH_MINUTES=30

# ---- Weekly email digest (optional) ----
# When these are set, everyone with an account gets an email every Sunday
# morning summarizing the upcoming week. Leave SMTP_HOST blank to disable email.

# Timezone the digest is scheduled/formatted in (IANA name).
TIMEZONE=America/New_York

# Public URL of your deployed app (used for the "Open the calendar" button).
APP_URL=https://your-app.onrender.com

# When to send (cron format). Default: 7:00 AM every Sunday.
DIGEST_CRON=0 7 * * 0

# SMTP mail server. For Gmail: create an "app password" (Google Account →
# Security → 2-Step Verification → App passwords) and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=The Goose Nest <you@gmail.com>
